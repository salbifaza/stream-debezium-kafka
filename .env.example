# Copy this file to .env before running `docker compose up`.

# Source Postgres (the "production" database being CDC'd) -- same defaults
# as stream-cdc-peerdb so the two projects' data is identical.
SOURCE_PG_USER=ecommerce
SOURCE_PG_PASSWORD=ecommerce
SOURCE_PG_DB=ecommerce

# ClickHouse destination.
# CLICKHOUSE_USER/PASSWORD is a bootstrap/admin identity used only to
# provision the scoped ETL user below (clickhouse/init/01_clickhouse_etl_user.sh)
# -- use it for ad-hoc operator queries, never for the sink connector itself.
CLICKHOUSE_USER=ch_admin
CLICKHOUSE_PASSWORD=ch_admin_password

# CLICKHOUSE_ETL_USER/PASSWORD is the least-privilege user the ClickHouse
# Kafka Connect sink connector actually connects as (see
# connectors/ch-sink-connector.json). If you change these, update that file
# too -- it isn't templated from .env.
CLICKHOUSE_ETL_USER=clickhouse_etl
CLICKHOUSE_ETL_PASSWORD=clickhouse_etl_password
